<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!--
        PrivacyInfo.xcprivacy — AquApp
        Doit rester aligné sur le code ET sur la fiche de confidentialité
        App Store Connect (voir docs/APP_STORE_PRIVACY.md).

        « Collecté » au sens d'Apple = transmis hors de l'appareil.
        Santé (HealthKit), profil, prénom, photo et historique restent sur
        l'iPhone : ils ne sont PAS déclarés ici.
    -->

    <!-- 1. Données collectées -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Position approximative (2 décimales, ~1 km) envoyée à api.open-meteo.com
             pour obtenir la température et adapter l'objectif en cas de canicule
             (WeatherManager). Aucun identifiant n'accompagne la requête. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- 2. Aucun tracking, aucun domaine de tracking -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- 3. APIs « required reason » utilisées par NOTRE code.
         Les frameworks Apple (SwiftData, WidgetKit…) déclarent les leurs. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1 : préférences propres à l'app -->
                <string>CA92.1</string>
                <!-- 1C8F.1 : UserDefaults de l'App Group group.com.fabian.dargaud.AquApp (WidgetBridge) -->
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
