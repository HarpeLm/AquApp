        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abuso di alcol è dannoso per la salute. Consumare con moderazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲みすぎは健康に害を及ぼします。適度な飲酒を心がけましょう。"
