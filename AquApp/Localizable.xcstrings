    "onboarding.page3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خض تحديات يومية وابقَ متحفزاً بفضل سلاسلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изпълнявай ежедневни предизвикателства, отключвай постижения и оставай мотивиран благодарение на сериите си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দৈনিক চ্যালেঞ্জ গ্রহণ করুন, অর্জন আনলক করুন এবং ধারাবাহিকতার মাধ্যমে অনুপ্রাণিত থাকুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plň denní výzvy, odemykej úspěchy a zůstaň motivovaný díky svým sériím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag daglige udfordringer, lås op for præstationer og hold dig motiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm tägliche Herausforderungen an und bleib mit deinen Serien motiviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναλάβετε ημερήσιες προκλήσεις, ξεκλειδώστε επιτεύγματα και παραμείνετε κινητοποιημένοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take on daily challenges, unlock achievements and stay motivated with your streaks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take on daily challenges, unlock achievements and stay motivated with your streaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supera retos diarios, desbloquea logros y mantente motivado con tus rachas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چالش‌های روزانه را تکمیل کن، دستاوردها را باز کن و با روندهایت انگیزه‌ات را حفظ کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita päivittäisiä haasteita, avaa saavutuksia ja pysy motivoituneena putkien avulla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggapin ang araw-araw na mga hamon, i-unlock ang mga tagumpay, at manatiling motivated gamit ang iyong mga streak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relevez des défis quotidiens, débloquez des succès et restez motivé grâce à vos séries."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבל אתגרים יומיים, פתח הישגים והישאר מונע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक चुनौतियां लें, उपलब्धियां अनलॉक करें और स्ट्रीक से प्रेरित रहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihvati svakodnevne izazove, otključaj dostignuća i ostani motiviran zahvaljujući nizovima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljesíts napi kihívásokat, oldj fel eredményeket, és maradj motivált a sorozataid révén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil tantangan harian, buka pencapaian, dan tetap termotivasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affronta sfide quotidiane e rimani motivato grazie alle tue serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日のチャレンジに挑み、連続記録でモチベーションを維持しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 챌린지에 도전하고, 업적을 잠금 해제하고, 연속 기록으로 동기부여를 유지하세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pêşbaziyên rojane qebûl bike, serkeftinan veke û bi rêzikan motîve bimîne."
