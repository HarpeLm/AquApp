    "onboarding.page2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل كل كوب ماء وحقق هدفك اليومي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записвай всяка чаша вода, проследявай напредъка си и постигай дневната си цел."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি গ্লাস পানি রেকর্ড করুন, অগ্রগতি ট্র্যাক করুন এবং দৈনিক লক্ষ্য অর্জন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávej každou sklenici vody, sleduj svůj pokrok a dosáhni denního cíle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log hvert glas vand, visualiser dine fremskridt og nå dit daglige mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiere jedes Glas Wasser und erreiche dein Tagesziel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταγράψτε κάθε ποτήρι νερό, οπτικοποιήστε την πρόοδό σας και επιτύχετε τον ημερήσιο στόχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log every glass of water, visualize your progress and reach your daily goal."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log every glass of water, visualise your progress and reach your daily goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra cada vaso de agua, visualiza tu progreso y alcanza tu objetivo diario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر لیوان آب را ثبت کن، پیشرفتت را دنبال کن و به هدف روزانه‌ات برس."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa jokainen vesilasi, seuraa edistymistäsi ja saavuta päivätavoitteesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-log ang bawat baso ng tubig, tingnan ang iyong pag-unlad, at abutin ang iyong araw-araw na layunin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez chaque verre d'eau, visualisez votre progression et atteignez votre objectif journalier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשום כל כוס מים, ראה את ההתקדמות שלך והשג את היעד היומי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर गिलास पानी रिकॉर्ड करें, अपनी प्रगति देखें और दैनिक लक्ष्य प्राप्त करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilježi svaku čašu vode, prati napredak i dostigni dnevni cilj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíts minden pohár vizet, kövesd nyomon a fejlődésedet, és érd el a napi célodat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat setiap gelas air, lihat kemajuan Anda, dan capai target harian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra ogni bicchiere d'acqua e raggiungi il tuo obiettivo quotidiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎杯の水を記録し、毎日の目標を達成しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물 한 잔 한 잔 기록하고, 진행 상황을 시각화하고, 일일 목표를 달성하세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her glasek avê tomar bike, pêşveçûna xwe bişopîne û armanca xwe ya rojane bigihîje."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiksuok kiekvieną stiklinę vandens, stebėk pažangą ir pasiek dienos tikslą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reģistrē katru glāzi ūdens, seko savam progresam un sasniedz dienas mērķi."
          }
        },
