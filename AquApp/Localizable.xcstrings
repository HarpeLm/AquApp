    "notif.permission.denied_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالإشعارات في الإعدادات لتلقي تذكيرات الترطيب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши известията от Настройки, за да получаваш напомняния за хидратация."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হাইড্রেশন রিমাইন্ডার পেতে সেটিংসে নোটিফিকেশন চালু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte oznámení v Nastavení, abyste dostávali připomínky k hydrataci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad notifikationer i Indstillinger for at modtage dine hydrationsadvarsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Benachrichtigungen in den Einstellungen, um Hydrationserinnerungen zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε τις ειδοποιήσεις στις Ρυθμίσεις για να λαμβάνετε υπενθυμίσεις ενυδάτωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow notifications in Settings to receive your hydration reminders."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow notifications in Settings to receive your hydration reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite las notificaciones en Ajustes para recibir tus recordatorios de hidratación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای دریافت یادآوری‌های آب‌رسانی، اعلان‌ها را از تنظیمات فعال کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli ilmoitukset Asetuksista saadaksesi nesteytysmuistutuksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang mga notification sa Settings para makatanggap ng iyong mga paalala sa hydration."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications dans les Réglages pour recevoir vos rappels hydratation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר התראות בהגדרות כדי לקבל תזכורות הידרציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाइड्रेशन रिमाइंडर प्राप्त करने के लिए सेटिंग्स में नोटिफिकेशन की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogući obavijesti u Postavkama kako bi primao podsjetnike za hidrataciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezd az értesítéseket a Beállításokban, hogy folyadékbeviteli emlékeztetőket kapj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan notifikasi di Pengaturan untuk menerima pengingat hidrasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche nelle Impostazioni per ricevere i promemoria di idratazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分補給リマインダーを受け取るには、設定で通知を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수분 섭취 알림을 받으려면 설정에서 알림을 허용하세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bo wergirtina bîranînên avahiyê di Sazkariyan de agahdariyan çalak bike."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įgalinkite pranešimus nustatymuose, kad gautumėte hidratacijos priminimus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iespējo paziņojumus iestatījumos, lai saņemtu hidratācijas atgādinājumus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan pemberitahuan dalam Tetapan untuk menerima peringatan hidrasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat varsler i Innstillinger for å motta hydreringspåminnelsene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta meldingen toe in Instellingen om hydratieherinneringen te ontvangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
