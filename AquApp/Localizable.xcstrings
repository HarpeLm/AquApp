    "challenge.grand_ecart.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرب قبل الساعة 9 صباحاً وبعد الساعة 9 مساءً في نفس اليوم"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пиене преди 9 ч И след 21 ч в същия ден"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সকাল ৯টার আগে এবং রাত ৯টার পরে একই দিনে পান করুন"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pít před 9 h A po 21 h ve stejný den"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drik inden kl. 9:00 OG efter kl. 21:00 på samme dag"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor 9 Uhr UND nach 21 Uhr am gleichen Tag trinken"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσιμο πριν τις 9:00 ΚΑΙ μετά τις 21:00 την ίδια μέρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink before 9am AND after 9pm on the same day"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink before 9am AND after 9pm on the same day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beber antes de las 9h Y después de las 21h el mismo día"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوشیدن قبل از ساعت ۹ و بعد از ساعت ۲۱ در همان روز"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juo ennen klo 9 JA klo 21 jälkeen samana päivänä"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uminom bago mag-9am AT pagkatapos ng 9pm sa parehong araw"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boire avant 9h ET après 21h dans la même journée"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתייה לפני 9:00 וגם אחרי 21:00 באותו יום"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसी दिन सुबह 9 बजे से पहले और रात 9 बजे के बाद पिएं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pijenje prije 9 h I nakon 21 h istog dana"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ivás 9 óra előtt ÉS 21 óra után ugyanazon a napon"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minum sebelum 09:00 DAN setelah 21:00 pada hari yang sama"
          }
        },
