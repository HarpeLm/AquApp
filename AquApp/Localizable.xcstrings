          "stringUnit" : {
            "state" : "translated",
            "value" : "হাইড্রেশন বজায় রাখতে, অগ্রগতি ট্র্যাক করতে এবং নিজের যত্ন নিতে আপনার দৈনিক সঙ্গী।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj denní společník pro udržení hydratace, sledování pokroku a péči o sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din daglige ledsager til at holde dig hydreret, spore dine fremskridt og tage vare på dig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein täglicher Begleiter, um hydratisiert zu bleiben und auf dich zu achten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καθημερινός σας σύντροφος για να παραμένετε ενυδατωμένοι και να παρακολουθείτε την πρόοδό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your daily companion to stay hydrated, track your progress and take care of yourself."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your daily companion to stay hydrated, track your progress and take care of yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero diario para mantenerte hidratado, seguir tu progreso y cuidarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراه روزانه تو برای حفظ آب‌رسانی، پیگیری پیشرفت و مراقبت از خودت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittäinen kumppanisi nesteytyksen ylläpitämiseen, edistymisen seurantaan ja itsestäsi huolehtimiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang iyong araw-araw na kasama para manatiling naka-hydrate, subaybayan ang iyong pag-unlad, at alagaan ang iyong sarili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compagnon quotidien pour rester hydraté, suivre vos progrès et prendre soin de vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הלווה היומי שלך להישאר מוּרווה, לעקוב אחר ההתקדמות ולטפל בעצמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाइड्रेटेड रहने, प्रगति ट्रैक करने और अपना ख्याल रखने का आपका दैनिक साथी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj svakodnevni suputnik za hidrataciju, praćenje napretka i brigu o sebi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napi társad a folyadékbevitel fenntartásához, a fejlődés nyomon követéséhez és önmagad gondozásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teman harian Anda untuk tetap terhidrasi, melacak kemajuan, dan merawat diri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo compagno quotidiano per rimanere idratato e seguire i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分補給を続け、進捗を追跡するための毎日のコンパニオン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수분 유지, 진행 상황 추적, 자기 관리를 위한 일상 동반자."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hevalê te yê rojane bo parastina avahiyê, şopandina pêşveçûnê û lênihêrîna xwe."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo kasdienė palydovė hidratacijos palaikymui, pažangos stebėjimui ir savęs priežiūrai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavs ikdienas pavadonis hidratācijas uzturēšanai, progresa izsekošanai un rūpēm par sevi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teman harian anda untuk kekal terhidrat, menjejak kemajuan dan menjaga diri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din daglige følgesvenn for å holde deg hydrert, spore fremgangen din og ta vare på deg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw dagelijkse metgezel om gehydrateerd te blijven en je voortgang bij te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój codzienny towarzysz, aby pozostać nawodnionym i śledzić postępy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu companheiro diário para se manter hidratado e acompanhar seu progresso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu companheiro diário para se manter hidratado, acompanhar o seu progresso e cuidar de si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tovarășul tău zilnic pentru a rămâne hidratat, a urmări progresul și a avea grijă de tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ежедневный помощник для поддержания водного баланса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj denný spoločník na udržanie hydratácie, sledovanie pokroku a starostlivosť o seba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj vsakodnevni spremljevalec za vzdrževanje hidracije, sledenje napredku in skrb zase."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoqëruesi yt i përditshëm për të mbajtur hidratimin, gjurmuar progresin dhe kujdesur veten."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твој свакодневни сапутник за хидратацију, праћење напретка и бригу о себи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dagliga följeslagare för att hålla dig hydrerad och följa dina framsteg."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Msaidizi wako wa kila siku wa kudumisha unyevu, kufuatilia maendeleo na kujitunza."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อนรายวันของคุณเพื่อดื่มน้ำอย่างเพียงพอ ติดตามความก้าวหน้า และดูแลตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıvı alımında kalmak ve ilerlemenizi takip etmek için günlük yoldaşınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій щоденний помічник для підтримки гідратації, відстеження прогресу та турботи про себе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người bạn đồng hành hàng ngày để giữ đủ nước, theo dõi tiến trình và chăm sóc bản thân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您保持水分充足、追踪进度的每日伴侣。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
