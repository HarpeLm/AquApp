    "premium.launch.notif.body" : {
      "comment" : "Body of the confirmation notification sent after registering for Premium launch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستكون من أوائل من يصلون إلى النسخة المميزة عند إطلاقها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще бъдеш сред първите с достъп до Premium веднага след стартирането."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লঞ্চের পরপরই আপনি প্রথমদের মধ্যে Premium অ্যাক্সেস পাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budeš mezi prvními, kdo bude mít přístup k Premium hned po spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil være blandt de første til at få adgang til Premium, når det lanceres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehören zu den Ersten, die beim Start auf Premium zugreifen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα είστε ανάμεσα στους πρώτους που θα έχουν πρόσβαση στο Premium κατά την κυκλοφορία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
