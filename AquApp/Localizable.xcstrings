    "premium.launch.message" : {
      "comment" : "Body message shown in the launch CTA section of PremiumSheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق مجاني تمامًا خلال الإطلاق. ستتوفر النسخة المميزة قريبًا — كن أول من يعلم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението е напълно безплатно по време на стартирането. Premium ще бъде достъпен скоро — бъди сред първите, които ще научат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লঞ্চের সময় অ্যাপটি সম্পূর্ণ বিনামূল্যে। Premium শীঘ্রই পাওয়া যাবে — প্রথম জানার মধ্যে থাকুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace je během spuštění zcela zdarma. Premium bude brzy dostupné — buď mezi prvními, kdo se to dozví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen er fuldstændig gratis ved lanceringen. Premium bliver tilgængeligt snart — vær den første til at vide det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App ist beim Start komplett kostenlos. Premium wird bald verfügbar sein — erfahren Sie es als Erster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή είναι εντελώς δωρεάν κατά την κυκλοφορία. Το Premium θα είναι σύντομα διαθέσιμο — μάθετε πρώτοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is completely free during launch. Premium will be available soon — be the first to know."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is completely free during launch. Premium will be available soon — be the first to know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app es completamente gratuita durante el lanzamiento. El Premium estará disponible pronto — sé el primero en saberlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه در دوران راه‌اندازی کاملاً رایگان است. Premium به‌زودی در دسترس خواهد بود — جزو اولین‌نفراتی باش که خبردار می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus on täysin ilmainen julkaisuvaiheen aikana. Premium julkaistaan pian — ole ensimmäisten joukossa kuulemassa siitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganap na libre ang app sa panahon ng paglulunsad. Malapit nang available ang Premium — maging una sa pagkaalam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app est entièrement gratuite pendant le lancement. Le Premium sera disponible prochainement — soyez les premiers informés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה חינמית לחלוטין בהשקה. פרמיום יהיה זמין בקרוב — היה הראשון לדעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉन्च के दौरान ऐप पूरी तरह मुफ्त है। प्रीमियम जल्द उपलब्ध होगा — पहले जानें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija je potpuno besplatna za vrijeme pokretanja. Premium uskoro stiže — budi među prvima koji će saznati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás teljesen ingyenes az indulás alatt. A Premium hamarosan elérhető lesz — légy az elsők között, akik értesülnek róla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini sepenuhnya gratis saat peluncuran. Premium akan segera tersedia — jadilah yang pertama mengetahuinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app è completamente gratuita durante il lancio. Il Premium sarà disponibile a breve — sii il primo a saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リリース期間中はアプリが完全無料です。プレミアムはまもなく提供開始 — 最初に知ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출시 중 앱은 완전히 무료입니다. 프리미엄이 곧 출시될 예정입니다 — 제일 먼저 알아보세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepan di dema destpêkê de bi tevahî belaş e. Premium zû berdest dibe — di nav yekemîn de be ku bizanibe."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programa paleidimo metu yra visiškai nemokama. Premium netrukus bus prieinamas — būk tarp pirmųjų, kurie sužinos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotne palaišanas laikā ir pilnīgi bezmaksas. Premium drīzumā būs pieejams — esi starp pirmajiem, kas uzzinās."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App ini percuma sepenuhnya semasa pelancaran. Premium akan tersedia tidak lama lagi — jadilah yang pertama mengetahuinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen er helt gratis ved lanseringen. Premium blir tilgjengelig snart — vær den første til å vite det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app is volledig gratis tijdens de lancering. Premium komt binnenkort beschikbaar — wees de eerste die het weet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja jest całkowicie bezpłatna podczas premiery. Premium będzie dostępne wkrótce — bądź pierwszym, który się dowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app é completamente gratuito durante o lançamento. O Premium estará disponível em breve — seja o primeiro a saber."
          }
