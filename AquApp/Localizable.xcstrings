    "onboarding.page4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط تذكيرات مخصصة حتى لا تنسى الشرب على مدار اليوم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настрой персонализирани напомняния, за да не забравяш да пиеш вода през деня."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যক্তিগতকৃত রিমাইন্ডার সেট করুন যাতে সারাদিন পানি পান করতে ভুলে না যান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav si vlastní připomínky, abys nikdy nezapomněl pít během dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil personlige påmindelser, så du aldrig glemmer at drikke i løbet af dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte personalisierte Erinnerungen ein, damit du nie vergisst zu trinken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίστε εξατομικευμένες υπενθυμίσεις ώστε να μην ξεχνάτε ποτέ να πίνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set personalized reminders so you never forget to drink throughout the day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set personalised reminders so you never forget to drink throughout the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura recordatorios personalizados para nunca olvidar beber agua durante el día."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادآوری‌های شخصی‌سازی‌شده تنظیم کن تا هرگز فراموش نکنی در طول روز آب بنوشی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta omat muistutuksesi, ettet koskaan unohda juoda päivän aikana."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-set ng mga personalized na paalala para hindi mo na makalimutang uminom sa buong araw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez des rappels personnalisés pour ne jamais oublier de boire tout au long de la journée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר תזכורות אישיות כדי שלא תשכח לשתות לאורך היום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे दिन पीना कभी न भूलें इसके लिए व्यक्तिगत रिमाइंडर सेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavi personalizirane podsjetnike kako nikad ne bi zaboravio piti vodu tijekom dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állíts be személyre szabott emlékeztetőket, hogy soha ne felejtsd el inni nap közben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur pengingat personal agar tidak pernah lupa minum sepanjang hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta promemoria personalizzati per non dimenticare mai di bere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日中飲むのを忘れないよう、リマインダーを設定しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 종일 마시는 것을 잊지 않도록 개인화된 알림을 설정하세요."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bîranînên taybet saz bike da ku tu carî ji bîr neke ku tu di nav rojê de vexwî."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatyk personalizuotus priminimus, kad niekada nepamiršytum gerti per dieną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestatiet personalizētus atgādinājumus, lai nekad neaizmirstu dzert dienas laikā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan peringatan peribadi agar tidak pernah lupa minum sepanjang hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett opp personlige påminnelser så du aldri glemmer å drikke i løpet av dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel gepersonaliseerde herinneringen in zodat je nooit vergeet te drinken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw spersonalizowane przypomnienia, by nigdy nie zapomnieć o piciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure lembretes personalizados para nunca esquecer de beber água."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure lembretes personalizados para nunca se esquecer de beber ao longo do dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează remindere personalizate ca să nu uiți niciodată să bei pe parcursul zilei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте персональные напоминания, чтобы не забывать пить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav si vlastné pripomienky, aby si nikdy nezabudol(a) piť počas dňa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi personalizirane opomnike, da nikoli ne pozabiš piti med dnem."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendos kujtues të personalizuar që të mos harrosh kurrë të pish gjatë ditës."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подеси персонализоване подсетнике да никада не заборавиш да пијеш воду током дана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in personliga påminnelser så att du aldrig glömmer att dricka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weka vikumbusho vilivyobinafsishwa ili usisahau kamwe kunywa maji wakati wa mchana."
