    "wrapped.closing.balance" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, لقد وجدت توازنًا رائعًا هذا العام. أحسنت! 💧"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, намери страхотен баланс тази година. Браво! 💧"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, আপনি এই বছর একটি চমৎকার ভারসাম্য খুঁজে পেয়েছেন। দারুণ! 💧"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, letos jsi našel/našla skvělou rovnováhu. Výborně! 💧"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, du fandt en flot balance i år. Godt gået! 💧"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, du hast dieses Jahr eine tolle Balance gefunden. Gut gemacht! 💧"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, βρήκες μια ωραία ισορροπία φέτος. Μπράβο! 💧"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, you found a great balance this year. Well done! 💧"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, you found a great balance this year. Well done! 💧"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, encontraste un gran equilibrio este año. ¡Bien hecho! 💧"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، امسال تعادل خوبی پیدا کردی. آفرین! 💧"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, löysit hienon tasapainon tänä vuonna. Hienoa työtä! 💧"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, natagpuan mo ang magandang balanse ngayong taon. Mahusay! 💧"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, tu as trouvé un bel équilibre cette année. Bravo ! 💧"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, מצאת איזון נהדר השנה. כל הכבוד! 💧"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, आपने इस साल एक अच्छा संतुलन पाया। शाबाश! 💧"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, pronašao/la si sjajnu ravnotežu ove godine. Bravo! 💧"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, remek egyensúlyt találtál ebben az évben. Szép munka! 💧"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, kamu menemukan keseimbangan yang baik tahun ini. Kerja bagus! 💧"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, hai trovato un ottimo equilibrio quest'anno. Ben fatto! 💧"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さん、今年はいいバランスを見つけましたね。よくやりました！💧"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님, 올해 멋진 균형을 찾으셨네요. 잘하셨어요! 💧"
          }
        },
        "ku" : {
