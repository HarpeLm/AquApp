        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação é completamente gratuita durante o lançamento. O Premium estará disponível em breve — seja o primeiro a saber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația este complet gratuită la lansare. Premium va fi disponibil în curând — fii primul care află."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение полностью бесплатно во время запуска. Премиум скоро появится — узнайте первым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia je počas spustenia úplne zdarma. Premium bude čoskoro dostupné — buď medzi prvými, kto sa to dozvie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija je med zagonom popolnoma brezplačna. Premium bo kmalu na voljo — bodi med prvimi, ki bodo izvedeli."
