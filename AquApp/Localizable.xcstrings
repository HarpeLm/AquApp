        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งการแจ้งเตือนส่วนตัวเพื่อไม่ลืมดื่มน้ำตลอดวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
