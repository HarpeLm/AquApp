    "challenge.active_day.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حقق هدفك في يوم تمشي فيه 10,000 خطوة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постигни целта в ден, в който изминеш 10 000 крачки"
