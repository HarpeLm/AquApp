        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacioni është plotësisht falas gjatë lansimit. Premium do të jetë i disponueshëm së shpejti — bëhu ndër të parët që do ta dijnë."
          }
