    "alcohol.warning.health" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إساءة استخدام الكحول تضر بالصحة. يُستهلك باعتدال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прекомерната консумация на алкохол вреди на здравето. Консумирайте умерено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অতিরিক্ত অ্যালকোহল স্বাস্থ্যের ক্ষতি করে। পরিমিতভাবে পান করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadměrná konzumace alkoholu škodí zdraví. Konzumujte s mírou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkoholmisbrug skader helbredet. Drik med måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkoholmissbrauch ist gesundheitsschädlich. In Maßen genießen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κατάχρηση αλκοόλ βλάπτει την υγεία. Καταναλώστε με μέτρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcohol abuse is harmful to health. Drink in moderation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcohol abuse is harmful to health. Drink in moderation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El abuso de alcohol es perjudicial para la salud. Beber con moderación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصرف بیش از حد الکل برای سلامتی مضر است. با اعتدال مصرف کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liiallinen alkoholinkäyttö on haitallista terveydelle. Käytä kohtuudella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang labis na pag-inom ng alak ay nakakasama sa kalusugan. Uminom nang katamtaman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abus d'alcool est dangereux pour la santé. À consommer avec modération."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש לרעה באלכוהול מזיק לבריאות. שתה במידה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शराब का दुरुपयोग स्वास्थ्य के लिए हानिकारक है। संयम से पीएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekomjerna konzumacija alkohola šteti zdravlju. Pij umjereno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A túlzott alkoholfogyasztás káros az egészségre. Fogyaszd mértékkel."
