          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez parmi les premiers à accéder au Premium dès sa sortie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
